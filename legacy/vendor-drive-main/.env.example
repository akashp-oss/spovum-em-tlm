# ============================================================
#  Vendor Drive — the ONLY file you edit. Copy to ".env".
#  The app runs fine with just the password set. The AI keys
#  are the one thing you add to switch on smart search.
# ============================================================

# 1) The shared password. Whoever has this gets in. CHANGE IT.
SITE_PASSWORD=changeme123

# Signs the login cookie. Any long random string is fine.
SECRET_KEY=change-this-to-any-long-random-string

# ------------------------------------------------------------
# 2) AI keys (both FREE, no credit card). Leave as-is to run
#    without AI — keyword search still works. Add them to turn
#    on "Ask the drive" and web sourcing.
# ------------------------------------------------------------
# Free, any Google account:  https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Free:                      https://tavily.com
TAVILY_API_KEY=your-tavily-key-here

# Which Gemini model to use. Leave as-is unless you want to pin one. If Google
# ever retires this name, the app auto-falls-back to a working one — it won't
# break. (Only set this if a 404 tells you to use a specific model.)
# GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------
# Everything below is OPTIONAL — you normally touch none of it.
# ------------------------------------------------------------

# Where EVERYTHING lives — the files themselves AND the search index.
# Local trial: leave this default (a local file, zero setup).
# To SHARE with friends online: paste a free Neon Postgres URL from
# https://neon.tech here. That database becomes the shared drive, so
# the data lives in the cloud (0.5 GB free ~ thousands of sheets),
# not on anyone's computer.
DATABASE_URL=sqlite:///./data/drive.db

# Daily AI caps so the free tiers can never be exceeded.
REASONING_DAILY_LIMIT=100
WEB_SEARCH_DAILY_LIMIT=30

# Optional email copy of pings — ONLY if you fill all three.
# Pings always land in the in-app Inbox regardless; this is extra.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# For the optional desktop popup script (watch.py):
VENDOR_SERVER_URL=http://localhost:8000

# HOST=0.0.0.0
# PORT=8000
